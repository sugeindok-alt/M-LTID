# Neon pooled PostgreSQL URL. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENFOODFACTS_CONTACT_EMAIL=
# Developer/educational test key. Check TheMealDB terms before commercial release.
THEMEALDB_API_KEY=1
# resend | file. file is accepted ONLY outside production, writes .local/mail.
EMAIL_TRANSPORT=file
# Use staging for development; production for the deployed product.
OPENFOODFACTS_ENV=staging
