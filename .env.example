# Neon pooled PostgreSQL URL. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# Service account JSON: server only, stored as a sensitive Vercel environment variable.
FIREBASE_SERVICE_ACCOUNT=
# Legacy Better Auth remains available only when AUTH_PROVIDER is not firebase.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Resend is optional for recipe emails. Firebase sends account emails without a custom domain.
# Resend in production still requires a verified sender domain.
OPENFOODFACTS_CONTACT_EMAIL=
# Developer/educational test key. Check TheMealDB terms before commercial release.
THEMEALDB_API_KEY=1
# resend | file. file is accepted ONLY outside production, writes .local/mail.
EMAIL_TRANSPORT=file
# Use staging for development; production for the deployed product.
OPENFOODFACTS_ENV=staging
