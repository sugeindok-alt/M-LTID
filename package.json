    "@better-auth/drizzle-adapter": "^1.7.14",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.14",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.65.0",
    "motion": "^14.8.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "name": "maltid",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "npm run typecheck && npm run lint && npm test",
    "mail:list": "node scripts/mail-list.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json README.md docs/*.md"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
